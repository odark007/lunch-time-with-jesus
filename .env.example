# Copy this file to .env and fill in real values.
# In Netlify, set these under Site settings > Environment variables instead.

# GitHub repo the admin write functions commit entries.json to
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=lunch-time-with-jesus
GITHUB_BRANCH=main

# Shared password checked server-side by the admin save/delete functions
ADMIN_PASSWORD=choose_a_password
